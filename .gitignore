node_modules/
dist/
public/app.js
public/workers/
# Logs brutos (eventos, ciclos, visao, snapshots) nunca entram no repositorio:
# mantenha-os no volume local ou em um diretorio fora do clone.
logs/*
!logs/.gitkeep
.env
.DS_Store
test-results/
playwright-report/
.playwright/
# Videos de avaliacao ficam locais (binarios/potencialmente sensiveis); as
# anotacoes .json e o README permanecem versionados.
bench/videos/*
bench/imagens/*
!bench/videos/README.md
!bench/videos/*.json

# Pesos de modelo locais (nao versionar).
# `modelos/` cobre os artefatos do modo offline (pesos) e o NSFW experimental
# em `modelos/yolonsfw/`.
modelos/

# Bibliotecas do modo offline (baixadas por `npm run preparar:offline`).
vendor/
