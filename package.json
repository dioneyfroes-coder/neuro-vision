{
  "name": "neuro-vision",
  "version": "0.1.0",
  "description": "Base open-source de visao computacional: a webcam enxerga e registra o que ve.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "node scripts/benchmark.mjs",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:node:*",
    "build:client": "esbuild public/app.ts --bundle --format=esm --outfile=public/app.js --external:https://*",
    "clean": "rimraf dist public/app.js",
    "start": "npm run build && node dist/server.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "esbuild public/app.ts --bundle --format=esm --outfile=public/app.js --external:https://* --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
