# Neuro Vision - configuracao via variaveis de ambiente.
# Copie este arquivo para `.env` e ajuste conforme o seu ambiente.
# O `.env` nao e versionado (veja .gitignore); se ele nao existir, valem os
# valores padrao definidos em src/env.ts.

# Servidor HTTP
PORT=3000
HOST=127.0.0.1
# 1 = permite expor o servidor em hosts de rede (ex.: 0.0.0.0)
NEURO_ALLOW_REMOTE=0
# Lista separada por virgula; vazio = apenas mesma origem
NEURO_ALLOWED_ORIGINS=

# Backend de visao: ollama | openai | lmstudio | auto
NEURO_PROVIDER=auto

# URLs base
# Ollama: http://localhost:11434
# LM Studio / OpenAI-compatible: http://localhost:1234 (ou a porta do LM Studio)
# NEURO_BASE_URL tem prioridade sobre OLLAMA_HOST / OPENAI_BASE_URL.
NEURO_BASE_URL=
OLLAMA_HOST=http://localhost:11434
OPENAI_BASE_URL=http://localhost:1234

# Chave de API (usada quando o provedor for openai)
NEURO_API_KEY=
OPENAI_API_KEY=

# Modelo de visao
# Ex.: llama3.2-vision:11b (Ollama) ou qwen2.5-vl-3b-instruct (LM Studio)
NEURO_MODEL=
OLLAMA_MODEL=

# Traducao (opcional)
NEURO_TRANSLATE_ENABLED=0
NEURO_TRANSLATE_MODEL=

# Imagens
# 1 = enviar base64 cru (workaround para algumas versoes do LM Studio)
NEURO_IMG_BASE64_CRU=0

# Limites e retencao (opcionais)
LOG_MAX_BYTES=5000000
SNAP_MAX_BYTES=200000000
SNAP_MAX_FILES=1000
SNAP_MAX_AGE_DAYS=30
SNAP_CLEAN_INTERVAL_MS=600000
SNAP_UPLOAD_MAX_BYTES=5000000
BODY_MAX_BYTES=1000000
VISAO_BODY_MAX_BYTES=12000000

# Testes / E2E (opcionais)
E2E_WEBCAM_CLIP=
E2E_WEBCAM_CHANNEL=
E2E_WEBCAM_DEBUG=0
E2E_WEBCAM_EVENTOS=
