# Neuro Vision - configuracao via variaveis de ambiente.
# Copie este arquivo para `.env` e ajuste conforme o seu ambiente.
# O `.env` nao e versionado (veja .gitignore); se ele nao existir, valem os
# valores padrao definidos em src/env.ts.

# Servidor HTTP
PORT=3000
HOST=127.0.0.1
# 1 = permite expor o servidor em hosts de rede (ex.: 0.0.0.0)
NEURO_ALLOW_REMOTE=0
# Lista separada por virgula; vazio = apenas mesma origem
NEURO_ALLOWED_ORIGINS=
# Fase 7: token Bearer opcional. Definido = exige autenticacao em API, UI e snapshots.
# Gere com algo como: openssl rand -base64 32. Nunca comite o valor real.
NEURO_API_TOKEN=
# 1 = marca o cookie de sessao como Secure (use quando terminar em HTTPS)
NEURO_HTTPS=0

# Backend de visao compativel com a API de chat completions do LM Studio
# (llama.cpp/llama-server e vLLM tambem funcionam).
# URL base do backend (vazio = http://localhost:1234).
# Ex.: http://127.0.0.1:1234 (padrao do LM Studio) ou a porta configurada.
NEURO_BASE_URL=

# Chave de API enviada como "Authorization: Bearer" (o LM Studio ignora).
NEURO_API_KEY=

# Modelo de visao (vazio = padrao qwen2.5-vl-3b-instruct).
# Use exatamente o id mostrado em GET /v1/models do backend.
NEURO_MODEL=
# Timeout por inferencia multimodal (ms; padrao 5 min, ajuste para seu hardware).
# A aplicacao nao envia max_tokens: o backend/modelo controla sua janela/contexto.
NEURO_VISION_TIMEOUT_MS=300000

# NSFW (Fase 5): configuracao declarada do Gemma. Vazio = identificador historico
# gemma-4-e2b-uncensored-hauhaucs-aggressive. Nao substitui modelos por si so;
# o modo NSFW nunca cai silenciosamente para o modelo SFW acima.
NEURO_MODELO_NSFW=
NEURO_GEMMA_VERSAO=
NEURO_GEMMA_QUANTIZACAO=
# 0 = desconhecido (nao medido).
NEURO_GEMMA_CONTEXTO_MAXIMO=0
NEURO_GEMMA_TEMPLATE_CONVERSA=

# Traducao (opcional)
NEURO_TRANSLATE_ENABLED=0
NEURO_TRANSLATE_MODEL=

# Imagens
# 1 = enviar base64 cru (workaround para algumas versoes do LM Studio)
NEURO_IMG_BASE64_CRU=0

# Limites e retencao (opcionais)
LOG_MAX_BYTES=5000000
SNAP_MAX_BYTES=200000000
SNAP_MAX_FILES=1000
SNAP_MAX_AGE_DAYS=30
SNAP_CLEAN_INTERVAL_MS=600000
SNAP_UPLOAD_MAX_BYTES=5000000
BODY_MAX_BYTES=1000000
VISAO_BODY_MAX_BYTES=12000000
# Videos de monitoramento. Retencao habilitada por padrao na Fase 7.
# Cada limite 0 desativa apenas aquele criterio (idade, quantidade ou espaco).
VIDEO_MAX_BYTES=209715200
VIDEO_RETENCAO_MS=2592000000
VIDEO_MAX_ARQUIVOS=500
VIDEO_MAX_BYTES_TOTAIS=5368709120
# Criptografia em repouso dos videos (AES-256-GCM): 32 bytes em base64 ou 64 hex.
# Vazio = gravacao em claro, declarada como `cifrado: null` no metadado.
NEURO_VIDEO_KEY=
# Alternativa: arquivo fora do repositorio contendo a chave (base64/hex).
NEURO_VIDEO_KEY_FILE=

# Testes / E2E (opcionais)
E2E_WEBCAM_CLIP=
E2E_WEBCAM_CHANNEL=
E2E_WEBCAM_DEBUG=0
E2E_WEBCAM_EVENTOS=
E2E_WEBCAM_MODEL=
E2E_WEBCAM_NSFW=0
E2E_WEBCAM_THRESHOLD=0.5
E2E_WEBCAM_DURATION_MS=0
E2E_LOCAL_MODELS_CLIP=
E2E_LOCAL_MODELS_CHANNEL=
E2E_LOCAL_MODELS_REQUIRE_HAND=1
